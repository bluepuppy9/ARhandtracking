# Godot-specific
.import/                # Imported assets (generated automatically)
.export/                # Export templates and exported projects
.godot/                 # Godot 4.x project settings (can be recreated)
*.godot_export          # Export templates (newer versions)
*.translation           # Translation cache (optional)

# OS-specific
.DS_Store               # macOS Finder metadata
Thumbs.db               # Windows thumbnail cache
desktop.ini             # Windows folder settings

# IDE/editor-specific
.vscode/                # VS Code settings
.idea/                  # JetBrains IDEs (Rider, CLion, etc.)
*.swp                   # Vim swap files
*.bak                   # Backup files

